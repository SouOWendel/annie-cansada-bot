{
	"name": "annie-cansada",
	"version": "2.2.0",
	"description": "Annie Cansada, uma personagem de Devilline HQ que virou um bot multifuncional.",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "node index.js",
		"restart": "node deploy-commands.js && node index.js",
		"register": "node deploy-commands.js",
		"dev": "nodemon index.js",
		"commitlint": "commitlint --edit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "husky install",
		"commit": "git-cz"
	},
	"author": "Wendel and Shay DeWael",
	"license": "MIT",
	"dependencies": {
		"ascii-table3": "^1.0.4",
		"cpu-stat": "^2.0.1",
		"discord.js": "^14.27.0",
		"dotenv": "^16.6.1",
		"kazagumo": "^3.4.3",
		"shoukaku": "^4.3.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^17.7.1",
		"@commitlint/config-conventional": "^17.7.0",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^8.48.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin": "^1.0.1",
		"eslint-plugin-import-helpers": "^1.3.1",
		"husky": "^8.0.3",
		"nodemon": "^2.0.15"
	},
	"repository": "https://github.com/Mark57449/Annie-Cansada.git",
	"husky": {
		"hooks": {
			"commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
			"prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
		}
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
